{
  "name": "pizza-pazzo",
  "version": "0.1.0",
  "private": true,
  "description": "Pizza Pazzo — online ordering system for a pizza restaurant (public site, digital menu, cart, orders, admin panel).",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "smoke": "node scripts/smoke-checkout.mjs",
    "smoke:deletion": "node scripts/smoke-account-deletion.mjs",
    "accounts:review": "node scripts/create-review-accounts.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "e2e:alarm": "node --experimental-websocket scripts/e2e-alarm.mjs",
    "icons:android": "node scripts/generate-android-icons.mjs",
    "icons:play": "node scripts/generate-play-assets.mjs",
    "test:payments": "node --import tsx --import ./tests/setup-env.mjs --test --test-concurrency=1 tests/payments-unit.test.ts tests/payments-flow.test.ts tests/payments-readiness.test.ts",
    "e2e:payments": "node --env-file=.env --import tsx scripts/e2e-card-payment.ts",
    "db:backup": "node scripts/backup-db.mjs",
    "db:seed-staging": "node scripts/seed-staging.mjs",
    "e2e:browser": "node --env-file=.env --import tsx scripts/e2e-browser-payments.ts",
    "test:ubb": "node --import tsx --import ./tests/setup-env.mjs --test --test-concurrency=1 tests/ubb-compliance.test.ts",
    "test": "npm run test:payments && npm run test:ubb",
    "db:verify-migration": "node scripts/verify-consent-migration.mjs",
    "e2e:ubb": "node --env-file=.env --import tsx scripts/e2e-ubb-browser.ts",
    "e2e:prod-guard": "node --env-file=.env --import tsx scripts/e2e-production-guard.ts",
    "e2e:checkout-links": "node --env-file=.env --import tsx scripts/e2e-checkout-links.ts",
    "e2e:footer-marks": "node --import tsx scripts/e2e-footer-marks.ts"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "next": "^15.5.20",
    "next-intl": "^4.13.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "resend": "^6.17.2",
    "zod": "^4.4.3",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.18.0",
    "eslint-config-next": "^15.5.20",
    "playwright-core": "^1.63.0",
    "postcss": "8.5.1",
    "prisma": "^5.22.0",
    "tailwindcss": "3.4.17",
    "tsx": "^4.23.15",
    "typescript": "5.7.3"
  }
}
