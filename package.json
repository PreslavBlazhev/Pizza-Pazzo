{
  "name": "pizza-pazzo",
  "version": "0.1.0",
  "private": true,
  "description": "Pizza Pazzo — online ordering system for a pizza restaurant (public site, digital menu, cart, orders, admin panel).",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "type-check": "tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "smoke": "node scripts/smoke-checkout.mjs",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "e2e:alarm": "node --experimental-websocket scripts/e2e-alarm.mjs",
    "icons:android": "node scripts/generate-android-icons.mjs"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.3",
    "next": "^15.5.20",
    "next-intl": "^4.13.2",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "resend": "^6.17.2",
    "zod": "^4.4.3",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "22.10.7",
    "@types/react": "19.0.7",
    "@types/react-dom": "19.0.3",
    "autoprefixer": "10.4.20",
    "eslint": "9.18.0",
    "eslint-config-next": "^15.5.20",
    "postcss": "8.5.1",
    "prisma": "^5.22.0",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.3"
  }
}
