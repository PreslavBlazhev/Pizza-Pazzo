<?xml version="1.0" encoding="utf-8"?>
<!-- HTTPS everywhere; plain HTTP is allowed ONLY toward local dev servers
     (used when testing against `next dev` on the same LAN). Release builds also
     refuse dev origins at the WebView layer (AllowedOrigins + ALLOW_DEV_ORIGINS). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.68.129</domain>
    </domain-config>
</network-security-config>
