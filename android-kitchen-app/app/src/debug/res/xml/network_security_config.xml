<?xml version="1.0" encoding="utf-8"?>
<!-- DEBUG ONLY. Plain HTTP toward a local dev server (`next dev` on the same
     LAN, or the emulator's 10.0.2.2 loopback). The release build uses the
     HTTPS-only config in src/main and also refuses dev origins at the WebView
     layer (AllowedOrigins + ALLOW_DEV_ORIGINS). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.68.129</domain>
    </domain-config>
</network-security-config>
