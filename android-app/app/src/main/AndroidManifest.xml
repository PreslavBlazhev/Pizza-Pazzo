<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Bluetooth Classic (SPP/RFCOMM) to an already-paired thermal printer.
         Android 12+ uses BLUETOOTH_CONNECT; older versions use the legacy pair.
         neverForLocation: we never derive location from Bluetooth. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT"
        tools:targetApi="s" />
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- Firebase Analytics merges these in for advertising: the advertising id
         and the Privacy Sandbox ad-services APIs. The app shows no ads and
         never collects the id (google_analytics_adid_collection_enabled
         below), so the permissions are removed outright. -->
    <uses-permission
        android:name="com.google.android.gms.permission.AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_AD_ID"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_ADSERVICES_ATTRIBUTION"
        tools:node="remove" />

    <uses-feature
        android:name="android.hardware.bluetooth"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.touchscreen"
        android:required="false" />

    <!-- allowBackup=false: the WebView cookie store holds a live STAFF/ADMIN
         session. Auto Backup would copy that session into the tablet owner's
         Google Drive and restore it onto any other device. Nothing in this app
         is worth backing up anyway — printer settings take seconds to re-enter.
         dataExtractionRules covers the same ground on Android 12+, including
         device-to-device transfer, which allowBackup alone does not. -->
    <application
        android:name=".PizzaPazzoApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="false"
        android:theme="@style/Theme.PizzaPazzo">

        <!-- Google Analytics for Firebase starts OFF, with every Consent Mode
             signal denied: nothing — not even first_open — is sent until the
             user allows it in the consent dialog (analytics/AppAnalytics.kt
             switches it on at runtime, and back off on withdrawal). Advertising
             signals stay denied for good. Screen views come from the site's
             routes (analytics/ScreenNames.kt), not from the one activity. -->
        <meta-data
            android:name="firebase_analytics_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_analytics_storage"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_storage"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_user_data"
            android:value="false" />
        <meta-data
            android:name="google_analytics_default_allow_ad_personalization_signals"
            android:value="false" />
        <meta-data
            android:name="google_analytics_adid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_ssaid_collection_enabled"
            android:value="false" />
        <meta-data
            android:name="google_analytics_automatic_screen_reporting_enabled"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.PizzaPazzo.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:parentActivityName=".MainActivity" />
    </application>
</manifest>
