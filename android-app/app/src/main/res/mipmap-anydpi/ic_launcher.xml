<?xml version="1.0" encoding="utf-8"?>
<!-- minSdk is 26, so adaptive icons cover every supported device — no legacy
     PNG mipmaps are needed.

     The foreground is the real Pizza Pazzo logo, generated from
     public/logos/pizza-pazzo-logo.png by scripts/generate-android-icons.mjs.
     Re-run that script if the logo changes; the PNGs are not hand-edited.

     The background is cream, NOT the brand red: the lettering in the logo is
     itself red, and on a red background it disappears. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
