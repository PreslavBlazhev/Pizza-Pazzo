<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <WebView
        android:id="@+id/webView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Thin progress bar on top while a page loads. -->
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/progressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:indeterminate="false"
        android:visibility="gone"
        app:indicatorColor="@color/pp_green"
        app:trackColor="@color/pp_cream" />

    <!-- Full-screen error / offline view. -->
    <LinearLayout
        android:id="@+id/errorView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/pp_cream"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone">

        <!-- Long-pressing the logo opens the native settings. It is the way
             back in when the site itself cannot load — a wrong start URL
             would otherwise leave nobody able to correct it, because the gear
             below only appears on the staff pages. -->
        <ImageView
            android:id="@+id/errorLogo"
            android:layout_width="140dp"
            android:layout_height="140dp"
            android:contentDescription="@string/app_name"
            android:src="@mipmap/ic_launcher_foreground" />

        <TextView
            android:id="@+id/errorTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/offline_title"
            android:textColor="@color/pp_ink"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/errorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="@string/offline_message"
            android:textColor="@color/pp_ink"
            android:textSize="16sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/retryButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:paddingHorizontal="40dp"
            android:paddingVertical="14dp"
            android:text="@string/retry"
            android:textSize="18sp"
            app:backgroundTint="@color/pp_green" />
    </LinearLayout>

    <!-- Discreet gear in the corner: the way into native printer settings.
         Hidden by default and shown only while the page is the staff area —
         see MainActivity.applyScreenModeFor(). A customer browsing the menu
         must never find a door into the printer configuration. -->
    <ImageButton
        android:id="@+id/settingsButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_gravity="bottom|end"
        android:layout_margin="10dp"
        android:alpha="0.45"
        android:background="@drawable/bg_settings_button"
        android:contentDescription="@string/open_settings"
        android:src="@android:drawable/ic_menu_manage"
        android:visibility="gone"
        app:tint="@color/white" />
</FrameLayout>
