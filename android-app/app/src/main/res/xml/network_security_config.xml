<?xml version="1.0" encoding="utf-8"?>
<!-- Release policy: HTTPS everywhere, no exceptions. The dev-server exception
     lives in src/debug/res/xml/network_security_config.xml, which only the
     debug build type merges in — so a shipped build physically cannot make a
     cleartext request. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
