// Pizza Pazzo — Prisma schema (SQLite).
//
// Local dev DB:  file:./dev.db                   (DATABASE_URL in .env / .env.local)
// Render prod:   file:/var/data/pizza-pazzo.db   (on a Persistent Disk mount)
//
// See docs/sqlite-prisma-setup.md and docs/render-sqlite-deploy.md.
// This models the order system built in Parts 2–3. Prices always use Decimal —
// never Float — and are stored in both BGN and EUR.
//
// NOTE — SQLite has no native enum type, so "enum" columns below are TEXT
// (String) whose allowed values are enforced at the application layer. The
// canonical value lists live in TypeScript:
//   UserRole        → types/user.ts  (CUSTOMER | STAFF | ADMIN | SUPER_ADMIN)
//   OrderStatus     → types/order.ts + lib/order-status.ts
//   PaymentMethod   → types/order.ts (CASH_ON_DELIVERY)
//   DeliveryMethod  → types/order.ts (DELIVERY)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  fullName     String
  phone        String?
  // UserRole enum (SQLite = TEXT): CUSTOMER | STAFF | ADMIN | SUPER_ADMIN
  role         String        @default("CUSTOMER")
  // Soft-disable for staff/customer accounts (admin deactivate/reactivate).
  isActive     Boolean       @default(true)

  addresses    UserAddress[]
  orders       Order[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model UserAddress {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  label        String   @default("Основен адрес")
  fullName     String?
  phone        String?
  city         String   @default("Плевен")
  addressLine  String
  entrance     String?
  floor        String?
  apartment    String?
  deliveryNote String?
  isDefault    Boolean  @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

model Order {
  id                    String      @id @default(cuid())
  // Human-friendly sequential number shown to staff. SQLite only allows
  // autoincrement on the @id column, so this is assigned in application logic
  // (Part 2), not by the database.
  orderNumber           Int         @unique

  userId                String?
  user                  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  customerName          String
  customerEmail         String
  customerPhone         String

  deliveryAddress       String
  deliveryCity          String      @default("Плевен")
  deliveryNote          String?

  // PaymentMethod enum (SQLite = TEXT): CASH_ON_DELIVERY
  paymentMethod         String      @default("CASH_ON_DELIVERY")
  // DeliveryMethod enum (SQLite = TEXT): DELIVERY
  deliveryMethod        String      @default("DELIVERY")

  // OrderStatus enum (SQLite = TEXT): PENDING | ACCEPTED | PREPARING | READY
  //   | OUT_FOR_DELIVERY | DELIVERED | CANCELLED
  status                String      @default("PENDING")

  subtotalBgn           Decimal
  subtotalEur           Decimal
  deliveryFeeBgn        Decimal     @default(0)
  deliveryFeeEur        Decimal     @default(0)
  totalBgn              Decimal
  totalEur              Decimal

  estimatedTimeMinutes  Int?
  adminNote             String?

  acceptedAt            DateTime?
  cancelledAt           DateTime?
  completedAt           DateTime?

  items                 OrderItem[]

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

// ── Menu (DB-backed since 2026-07-18, see docs/admin-menu-db-plan.md) ───────
//
// The id/slug values from data/*.json are PRESERVED on import so that
// OrderItem.productId/variantId on existing orders stay valid, and so the
// public URLs (/product/[slug]) never change. Slugs are deliberately not
// editable from the admin (SEO). data/*.json stays in the repo as seed/backup;
// after the one-time import the database is the source of truth.

model MenuCategory {
  id            String        @id // preserved cat_* ids from the JSON seed
  slug          String        @unique
  nameBg        String
  nameEn        String
  descriptionBg String        @default("")
  descriptionEn String        @default("")
  icon          String?
  sortOrder     Int           @default(0)
  isActive      Boolean       @default(true)

  products      MenuProduct[]
}

model MenuProduct {
  id                  String        @id // preserved prod_* ids
  slug                String        @unique // preserved — public URL + SEO
  nameBg              String
  nameEn              String
  descriptionBg       String        @default("")
  descriptionEn       String        @default("")
  categoryId          String
  category            MenuCategory  @relation(fields: [categoryId], references: [id])

  // Base price; for products with variants this is the "from" price.
  priceBgn            Decimal
  priceEur            Decimal

  imageUrl            String?
  // JSON array of allergen ids (SQLite has no arrays) — see lib/allergens.ts.
  allergens           String        @default("[]")
  // True until the kitchen confirms the allergen list (EU 1169/2011) — the UI
  // then shows "being confirmed, ask the staff" instead of claiming "none".
  allergensUnverified Boolean       @default(false)
  sizeBg              String?
  sizeEn              String?
  isAvailable         Boolean       @default(true)
  isPopular           Boolean       @default(false)
  isNew               Boolean       @default(false)
  sortOrder           Int           @default(0)

  variants            MenuVariant[]

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([categoryId])
}

model MenuVariant {
  id        String      @id // preserved var_* ids — referenced by OrderItem.variantId
  productId String
  product   MenuProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  nameBg    String
  nameEn    String
  priceBgn  Decimal
  priceEur  Decimal
  sortOrder Int         @default(0)

  @@index([productId])
}

model OrderItem {
  id              String   @id @default(cuid())

  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId       String
  productSlug     String?
  productNameBg   String
  productNameEn   String?
  productImageUrl String?

  variantId       String?
  variantName     String?

  quantity        Int

  // Unit price of the BASE product/variant (extras are NOT folded in here —
  // totalPrice* carries the full line total including extras).
  unitPriceBgn    Decimal
  unitPriceEur    Decimal
  totalPriceBgn   Decimal
  totalPriceEur   Decimal

  // Immutable snapshot of the chosen extras (crust/addons/sauces) as a JSON
  // array of OrderItemExtra (see lib/extras-rules.ts). SQLite has no JSON
  // column type; "[]" means no extras. Never read live menu data for this.
  extrasJson      String   @default("[]")

  itemNote        String?

  createdAt       DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}
