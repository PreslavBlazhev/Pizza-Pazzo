// Pizza Pazzo — Prisma schema (SQLite).
//
// Local dev DB:  file:./dev.db                   (DATABASE_URL in .env / .env.local)
// Render prod:   file:/var/data/pizza-pazzo.db   (on a Persistent Disk mount)
//
// See docs/sqlite-prisma-setup.md and docs/render-sqlite-deploy.md.
// This models the order system built in Parts 2–3. Prices always use Decimal —
// never Float — and the euro is the only currency stored anywhere.
//
// NOTE — SQLite has no native enum type, so "enum" columns below are TEXT
// (String) whose allowed values are enforced at the application layer. The
// canonical value lists live in TypeScript:
//   UserRole        → types/user.ts  (CUSTOMER | STAFF | ADMIN | SUPER_ADMIN)
//   OrderStatus     → types/order.ts + lib/order-status.ts
//   PaymentMethod   → types/order.ts (CASH_ON_DELIVERY | CARD_ONLINE)
//   PaymentStatus   → types/order.ts + lib/payments/status.ts
//   DeliveryMethod  → types/order.ts (DELIVERY)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ── Models ──────────────────────────────────────────────────────────────────

model User {
  id           String        @id @default(cuid())
  email        String        @unique
  passwordHash String
  fullName     String
  phone        String?
  // UserRole enum (SQLite = TEXT): CUSTOMER | STAFF | ADMIN | SUPER_ADMIN
  role         String        @default("CUSTOMER")
  // Soft-disable for staff/customer accounts (admin deactivate/reactivate).
  isActive     Boolean       @default(true)

  addresses    UserAddress[]
  orders       Order[]

  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

model UserAddress {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  label        String   @default("Основен адрес")
  fullName     String?
  phone        String?
  city         String   @default("Плевен")
  addressLine  String
  entrance     String?
  floor        String?
  apartment    String?
  deliveryNote String?
  isDefault    Boolean  @default(false)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
}

/// Restaurant contact details + opening hours, editable from /admin/settings.
///
/// Exactly ONE row, with the fixed id "restaurant" — this is deliberately a
/// typed table rather than a generic key/value store, so every field keeps its
/// type and its validation. The initial row is written by the migration itself
/// (not by the seed), so a production deploy always has valid settings.
///
/// Times are "HH:mm" strings (SQLite has no TIME type); a closed day keeps
/// `*Open = false` and leaves its two time columns null. Anything operational —
/// Resend sender/recipient, admin login — stays in environment variables and is
/// NOT part of this table: `contactEmail` is the address shown to customers.
model RestaurantSettings {
  id             String  @id @default("restaurant")

  addressBg      String
  addressEn      String

  primaryPhone   String
  secondaryPhone String?
  contactEmail   String

  mondayOpen     Boolean @default(true)
  mondayFrom     String?
  mondayTo       String?

  tuesdayOpen    Boolean @default(true)
  tuesdayFrom    String?
  tuesdayTo      String?

  wednesdayOpen  Boolean @default(true)
  wednesdayFrom  String?
  wednesdayTo    String?

  thursdayOpen   Boolean @default(true)
  thursdayFrom   String?
  thursdayTo     String?

  fridayOpen     Boolean @default(true)
  fridayFrom     String?
  fridayTo       String?

  saturdayOpen   Boolean @default(true)
  saturdayFrom   String?
  saturdayTo     String?

  sundayOpen     Boolean @default(true)
  sundayFrom     String?
  sundayTo       String?

  /// Manual closure, set from the "Затвори заведението" button in the admin
  /// panel. It overrides the opening hours above: while it is active the site
  /// refuses new orders even inside working hours.
  ///
  /// `closedUntil` is the whole difference between the two closure modes:
  ///   - a timestamp → the shop reopens BY ITSELF once that moment passes
  ///     (nothing writes to this row at expiry; the state is derived at read
  ///     time, so no cron job is needed);
  ///   - null while `manuallyClosed` is true → closed until a human presses
  ///     "Отвори заведението".
  manuallyClosed Boolean  @default(false)
  closedUntil    DateTime?
  /// When the current closure was started, and by whom — shown to the staff so
  /// they know who paused the shift.
  closedAt       DateTime?
  closedByEmail  String?

  /// Forced opening, set from "Отвори принудително" in the admin panel. The
  /// mirror image of the closure above: it overrides the opening hours in the
  /// other direction, so the site takes orders at 03:00 if someone decided the
  /// kitchen is working tonight.
  ///
  /// `openUntil` reads exactly like `closedUntil`: a timestamp expires by
  /// itself at read time, null means "until someone presses stop".
  ///
  /// A closure and a forced opening are mutually exclusive — each write clears
  /// the other — so "which one wins" is never a question anyone has to answer.
  /// Card-payment DEMO on the live site (the payment simulator, no real
  /// money), switched from Admin → Settings: OFF | STAFF (only signed-in
  /// staff/admins see the card option) | EVERYONE. Demo orders are always
  /// test orders ("ТЕСТ — НЕ ПРИГОТВЯЙ"). See lib/payments/demo.ts.
  cardDemoMode   String   @default("OFF")

  manuallyOpen   Boolean  @default(false)
  openUntil      DateTime?
  openedAt       DateTime?
  openedByEmail  String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

/// One printable ticket layout, editable from /admin/settings/print.
///
/// Exactly TWO rows, ids "KITCHEN" and "DELIVERY" — an order prints a
/// preparation slip and a delivery slip, and the owner styles them separately.
/// Both rows are written by the migration itself, so a production deploy has
/// working templates without a seed step.
///
/// `sectionsJson` is the one deliberate exception to this project's
/// typed-column rule: the per-section style set is 21 sections × 5 attributes,
/// which as columns would be unmaintainable and would need a migration every
/// time a section is added. It is a JSON object validated by
/// lib/validators/print-template.ts on write and merged over the defaults in
/// types/print.ts on read, so unknown or missing sections degrade to the
/// default instead of breaking a ticket.
model PrintTemplate {
  id             String   @id // "KITCHEN" | "DELIVERY"
  name           String

  paperWidthMm   Int      @default(80)
  charsPerLine   Int      @default(42)
  marginMm       Float    @default(3)
  lineHeight     Float    @default(1.25)

  headerText     String   @default("PIZZA PAZZO")
  footerText     String   @default("")
  showDividers   Boolean  @default(true)

  feedLinesAfter Int      @default(4)
  autoCut        Boolean  @default(true)
  copies         Int      @default(1)

  sectionsJson   String   @default("{}")

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Order {
  id                    String      @id @default(cuid())
  // Human-friendly sequential number shown to staff. SQLite only allows
  // autoincrement on the @id column, so this is assigned in application logic
  // (Part 2), not by the database.
  orderNumber           Int         @unique

  userId                String?
  user                  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)

  customerName          String
  customerEmail         String
  customerPhone         String

  deliveryAddress       String
  deliveryCity          String      @default("Плевен")
  deliveryNote          String?

  // PaymentMethod enum (SQLite = TEXT): CASH_ON_DELIVERY | CARD_ONLINE
  paymentMethod         String      @default("CASH_ON_DELIVERY")
  // PaymentStatus enum (SQLite = TEXT) — deliberately SEPARATE from `status`
  // (the kitchen's view of the order). See lib/payments/status.ts:
  //   CASH_DUE          cash order, the driver collects the money
  //   AWAITING_PAYMENT  card order, no confirmed payment yet
  //   PAID              the provider confirmed the payment server-to-server
  //   FAILED | CANCELLED | EXPIRED   the last card attempt did not go through
  paymentStatus         String      @default("CASH_DUE")
  paidAt                DateTime?
  // DeliveryMethod enum (SQLite = TEXT): DELIVERY
  deliveryMethod        String      @default("DELIVERY")

  // OrderStatus enum (SQLite = TEXT): PENDING | ACCEPTED | PREPARING | READY
  //   | OUT_FOR_DELIVERY | DELIVERED | CANCELLED
  status                String      @default("PENDING")

  subtotalEur           Decimal
  deliveryFeeEur        Decimal     @default(0)
  totalEur              Decimal

  /// When the order became visible to the kitchen (live board, dashboard
  /// counters, the restaurant e-mail). A cash order is released at checkout;
  /// a card order only once its payment is confirmed. Null = the kitchen has
  /// never seen it and must not.
  releasedToKitchenAt   DateTime?
  /// The restaurant's "new order" e-mail — see notifyRestaurantOnce in
  /// lib/payments/service.ts. `notificationSentAt` is set ONLY once Resend
  /// accepted the message; the other four columns account for everything
  /// else, so a failed send is visible and retried instead of looking sent.
  notificationSentAt    DateTime?
  /// null (not attempted) | SENDING | SENT | SKIPPED | FAILED | LEGACY (pre-2026-09-26 orders)
  notificationStatus    String?
  notificationAttempts  Int         @default(0)
  /// Why it was skipped or why the last attempt failed (no secrets).
  notificationError     String?
  /// When the current/last attempt started — a lease that stops two
  /// requests from sending at once, and the clock for the next retry.
  notificationClaimedAt DateTime?

  /// Unguessable token that lets whoever placed the order (a guest has no
  /// account) open its payment page and result. Never shown to staff.
  accessToken           String?     @unique
  /// Client-generated key of one checkout attempt: a double click or a
  /// repeated request returns the order already created instead of a second.
  checkoutKey           String?     @unique
  /// Placed through the payment SIMULATOR — no real money, never real food.
  isTest                Boolean     @default(false)
  /// Short lock taken while a payment session is being created, so two
  /// concurrent "Pay" clicks cannot open two sessions at the provider.
  paymentLockedUntil    DateTime?
  /// Something about the money a human has to look at (see PAYMENT_ALERTS in
  /// lib/payments/status.ts) — e.g. a payment confirmed only after the
  /// customer gave up, or a second successful attempt on the same order.
  paymentAlert          String?

  estimatedTimeMinutes  Int?
  adminNote             String?

  acceptedAt            DateTime?
  cancelledAt           DateTime?
  completedAt           DateTime?

  /// When the customer's personal fields above were scrubbed — see lib/privacy.ts.
  /// The order itself stays: number, date, items and sums are the accounting
  /// record. Name, e-mail, phone, address and note are not, so deleting the
  /// account takes them out of here too.
  anonymizedAt          DateTime?
  /// Set when the account was deleted while this order was still being
  /// cooked or driven. The address is needed to finish delivering it, so the
  /// scrub is deferred to the moment the order reaches DELIVERED or CANCELLED.
  anonymizePending      Boolean     @default(false)

  items                 OrderItem[]
  paymentAttempts       PaymentAttempt[]

  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([paymentStatus])
  @@index([releasedToKitchenAt])
}

/// One attempt to pay an order online. An order may have several (the first
/// was declined, the customer tried again) — never more than one PAID in a
/// correct world, and if a provider ever reports a second one it is kept and
/// flagged instead of hidden.
///
/// Holds no card data of any kind: the card is typed only on the provider's
/// hosted page. `providerResponse` is a size-capped diagnostic snapshot from
/// which the adapter has already stripped every card field.
model PaymentAttempt {
  id                 String    @id @default(cuid())
  orderId            String
  order              Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)

  /// Our unique reference, sent to the provider as its order number.
  reference          String    @unique
  /// "SIMULATOR" or the bank adapter's id.
  provider           String
  /// "simulator" | "sandbox" | "production" — frozen at creation.
  environment        String
  /// The provider's own id for the session/transaction.
  providerPaymentId  String?
  /// Hosted payment page the customer is sent to.
  redirectUrl        String?

  /// Amount in the currency's smallest unit (euro cents), copied from the
  /// stored order total; the provider must confirm exactly this.
  amountMinor        Int
  /// ISO 4217 alphabetic code, e.g. "EUR".
  currency           String

  /// Internal status (ATTEMPT_STATUSES in lib/payments/status.ts):
  /// CREATED | REDIRECTED | PENDING | PAID | FAILED | CANCELLED | EXPIRED | ERROR
  status             String    @default("CREATED")
  /// The provider's raw status code, verbatim — for diagnosis only.
  providerStatus     String?
  providerResponse   String?
  failureReason      String?
  /// Locale the customer paid in — sends them back to the right pages.
  locale             String    @default("bg")

  lastCheckedAt      DateTime?
  finalizedAt        DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([orderId])
  @@index([providerPaymentId])
  @@index([status])
}

/// The payment SIMULATOR's own ledger. It plays the bank's database, so the
/// rest of the system talks to it exactly as it will talk to a real provider:
/// create a session, send the customer to a hosted page, ask for the status.
///
/// Only ever written when PAYMENT_PROVIDER=simulator, which lib/payments/config
/// refuses unless APP_ENV is development or staging. Empty in production.
model PaymentSimulatorSession {
  id           String    @id @default(cuid())
  reference    String    @unique
  amountMinor  Int
  currency     String
  description  String    @default("")
  returnUrl    String
  callbackUrl  String?
  /// OPEN | PAID | DECLINED | CANCELLED | PENDING
  state        String    @default("OPEN")
  /// "Late confirmation" scenario: a PENDING session turns into `resolveTo`
  /// by itself once this moment has passed.
  resolveAt    DateTime?
  resolveTo    String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

// ── Menu (DB-backed since 2026-07-18, see docs/admin-menu-db-plan.md) ───────
//
// The id/slug values from data/*.json are PRESERVED on import so that
// OrderItem.productId/variantId on existing orders stay valid, and so the
// public URLs (/product/[slug]) never change. Slugs are deliberately not
// editable from the admin (SEO). data/*.json stays in the repo as seed/backup;
// after the one-time import the database is the source of truth.

model MenuCategory {
  id            String        @id // preserved cat_* ids from the JSON seed
  slug          String        @unique
  nameBg        String
  nameEn        String
  descriptionBg String        @default("")
  descriptionEn String        @default("")
  icon          String?
  sortOrder     Int           @default(0)
  isActive      Boolean       @default(true)

  products      MenuProduct[]
}

model MenuProduct {
  id                  String        @id // preserved prod_* ids
  slug                String        @unique // preserved — public URL + SEO
  nameBg              String
  nameEn              String
  descriptionBg       String        @default("")
  descriptionEn       String        @default("")
  categoryId          String
  category            MenuCategory  @relation(fields: [categoryId], references: [id])

  // Base price in EUR; for products with variants this is the "from" price.
  priceEur            Decimal

  imageUrl            String?
  // JSON array of allergen ids (SQLite has no arrays) — see lib/allergens.ts.
  allergens           String        @default("[]")
  // True until the kitchen confirms the allergen list (EU 1169/2011) — the UI
  // then shows "being confirmed, ask the staff" instead of claiming "none".
  allergensUnverified Boolean       @default(false)
  sizeBg              String?
  sizeEn              String?
  isAvailable         Boolean       @default(true)
  isPopular           Boolean       @default(false)
  isNew               Boolean       @default(false)
  sortOrder           Int           @default(0)

  variants            MenuVariant[]

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  @@index([categoryId])
}

model MenuVariant {
  id        String      @id // preserved var_* ids — referenced by OrderItem.variantId
  productId String
  product   MenuProduct @relation(fields: [productId], references: [id], onDelete: Cascade)

  nameBg    String
  nameEn    String
  priceEur  Decimal
  sortOrder Int         @default(0)

  @@index([productId])
}

model OrderItem {
  id              String   @id @default(cuid())

  orderId         String
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId       String
  productSlug     String?
  productNameBg   String
  productNameEn   String?
  productImageUrl String?

  variantId       String?
  variantName     String?

  quantity        Int

  // Unit price of the BASE product/variant in EUR (extras are NOT folded in
  // here — totalPriceEur carries the full line total including extras).
  unitPriceEur    Decimal
  totalPriceEur   Decimal

  // Immutable snapshot of the chosen extras (crust/addons/sauces) as a JSON
  // array of OrderItemExtra (see lib/extras-rules.ts). SQLite has no JSON
  // column type; "[]" means no extras. Never read live menu data for this.
  extrasJson      String   @default("[]")

  itemNote        String?

  createdAt       DateTime @default(now())

  @@index([orderId])
  @@index([productId])
}
