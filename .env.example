# ─────────────────────────────────────────────────────────────
# Pizza Pazzo — environment variables (EXAMPLE)
# Copy this file to `.env.local` and fill in real values there.
# NEVER commit real credentials. `.env.local` is gitignored.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_SITE_NAME="Pizza Pazzo"
# THE public address of this deployment (no trailing slash). Canonical/OG
# URLs, sitemap, robots and the bank's return/callback addresses all come from
# it. Production: https://… (the .com domain later — docs/domain-and-deploy.md).
APP_BASE_URL="http://localhost:3000"
# Older name, still honoured as a fallback for APP_BASE_URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# development | staging | production. Missing on a production build = production.
APP_ENV=development
# Optional password in front of a STAGING deployment ("user:password").
# Never applies in production and never to /api (bank callbacks get through).
STAGING_BASIC_AUTH=

# ── Database (SQLite + Prisma) ───────────────────────────────
# Локално: SQLite файл в проекта (relative to prisma/schema.prisma).
DATABASE_URL="file:./dev.db"
#
# На Render: DATABASE_URL трябва да сочи към Persistent Disk mount,
# напр. /var/data. Без Persistent Disk базата се губи при redeploy/restart.
# В Render задай DATABASE_URL = стойността по-долу (не тази отгоре):
RENDER_DATABASE_URL="file:/var/data/pizza-pazzo.db"

# ── Качени продуктови снимки (admin upload) ──────────────────
# Локално: gitignore-ната папка .data/uploads в проекта (не е нужно да се
# задава). На Render: подпапка на същия Persistent Disk като базата — вече
# зададена в render.yaml (UPLOADS_DIR=/var/data/uploads). Без Persistent Disk
# качените снимки се губят при redeploy/restart, също като базата.
UPLOADS_DIR=

# ── Auth (custom, SQLite/Prisma) ─────────────────────────────
# Таен ключ за подписване на session JWT (httpOnly cookie).
# Генерирай дълъг случаен низ, напр.:  openssl rand -base64 32
# На Render — сложи го като Environment Variable (не го commit-вай).
AUTH_SECRET=

# Първи SUPER_ADMIN — създава се от `npm run db:seed`.
# Смени паролата след първия вход. Не commit-вай реални стойности.
ADMIN_EMAIL=pr2.blazhev@gmail.com
ADMIN_PASSWORD=

# ── Email (transactional, Resend) ────────────────────────────
# RESEND_API_KEY се взима от resend.com. Ако липсва — поръчките работят,
# само имейл известието се пропуска.
RESEND_API_KEY=
ORDER_NOTIFICATION_EMAIL=pr2.blazhev@gmail.com
FROM_EMAIL="Pizza Pazzo <orders@pizzapazzo.bg>"

# ── Online card payments ─────────────────────────────────────
# Full guide: docs/online-card-payments.md. OFF unless all of this is valid.
# The emergency switch: CARD_PAYMENTS_ENABLED=false.
CARD_PAYMENTS_ENABLED=false
# "simulator" (development/staging ONLY — refused when APP_ENV=production)
# or "bank" (the real adapter, not implemented until the bank is chosen).
PAYMENT_PROVIDER=
# Bank only: sandbox (never with APP_ENV=production) | production (only with it).
PAYMENT_ENV=
# Bank only: the currency on the merchant contract. The site charges EUR only.
PAYMENT_CURRENCY=
# Simulator only: signs its callbacks. Long random string (>= 16 chars).
PAYMENT_SIMULATOR_SECRET=
# Bank credentials go here once the bank's documentation defines them
# (see lib/payments/providers/bank.ts). Never commit real values.

# ── Printing — НЕ е свързано още ─────────────────────────────
# PRINTER_MODE="browser" # browser | network | agent
