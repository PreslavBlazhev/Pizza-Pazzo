# ─────────────────────────────────────────────────────────────
# Pizza Pazzo — environment variables (EXAMPLE)
# Copy this file to `.env.local` and fill in real values there.
# NEVER commit real credentials. `.env.local` is gitignored.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_SITE_NAME="Pizza Pazzo"
# THE public address of this deployment (no trailing slash). Canonical/OG
# URLs, sitemap, robots and the bank's return/callback addresses all come from
# it. Production: https://… (the .com domain later — docs/domain-and-deploy.md).
APP_BASE_URL="http://localhost:3000"
# Older name, still honoured as a fallback for APP_BASE_URL.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# development | staging | production. Missing on a production build = production.
APP_ENV=development
# Optional password in front of a STAGING deployment ("user:password"), or
# just STAGING_BASIC_AUTH_PASSWORD with the user "staging".
# Never applies in production and never to /api (bank callbacks get through).
STAGING_BASIC_AUTH=
STAGING_BASIC_AUTH_PASSWORD=
# Test logins made by scripts/seed-staging.mjs (staging/development only, >= 12 chars).
STAGING_ADMIN_PASSWORD=
STAGING_STAFF_PASSWORD=
STAGING_CUSTOMER_PASSWORD=

# ── Database (SQLite + Prisma) ───────────────────────────────
# Локално: SQLite файл в проекта (relative to prisma/schema.prisma).
DATABASE_URL="file:./dev.db"
#
# На Render: DATABASE_URL трябва да сочи към Persistent Disk mount,
# напр. /var/data. Без Persistent Disk базата се губи при redeploy/restart.
# В Render задай DATABASE_URL = стойността по-долу (не тази отгоре):
RENDER_DATABASE_URL="file:/var/data/pizza-pazzo.db"

# ── Качени продуктови снимки (admin upload) ──────────────────
# Локално: gitignore-ната папка .data/uploads в проекта (не е нужно да се
# задава). На Render: подпапка на същия Persistent Disk като базата — вече
# зададена в render.yaml (UPLOADS_DIR=/var/data/uploads). Без Persistent Disk
# качените снимки се губят при redeploy/restart, също като базата.
UPLOADS_DIR=

# ── Auth (custom, SQLite/Prisma) ─────────────────────────────
# Таен ключ за подписване на session JWT (httpOnly cookie).
# Генерирай дълъг случаен низ, напр.:  openssl rand -base64 32
# На Render — сложи го като Environment Variable (не го commit-вай).
AUTH_SECRET=

# Първи SUPER_ADMIN — създава се от `npm run db:seed`. Това е ВХОДЪТ на
# разработчика (BDS) в админ панела, не контакт на пицарията — затова не е
# pizzapazzopln@gmail.com. Публичният имейл е в Admin → Настройки.
# Смени паролата след първия вход. Не commit-вай реални стойности.
ADMIN_EMAIL=info@bulgaria-digital-services.com
ADMIN_PASSWORD=

# ── Email (transactional, Resend) ────────────────────────────
# RESEND_API_KEY се взима от resend.com. Ако липсва — поръчките работят,
# само имейл известието се пропуска.
RESEND_API_KEY=
# "disabled" switches real sending off anywhere. APP_ENV=staging never sends.
EMAIL_DELIVERY=
ORDER_NOTIFICATION_EMAIL=pizzapazzopln@gmail.com
# MUST be an address on a domain VERIFIED in Resend (DKIM/SPF records in DNS).
# Never onboarding@resend.dev in production: Resend delivers from it only to
# the Resend account owner's own address, so customers get nothing. With
# APP_ENV=production the site refuses to send customer e-mail from it.
FROM_EMAIL="Pizza Pazzo <orders@pizzapazzo.bg>"

# ── Maintenance ──────────────────────────────────────────────
# Optional. Long random string (>= 32 chars). Enables POST /api/maintenance/run
# for a scheduler: the customer e-mail outbox and restaurant e-mail retries.
# The daily 22:30 deletion is SWITCHED OFF (the order history is kept,
# lib/order-retention.ts) — this endpoint never deletes anything. Without it
# the endpoint answers 404 and the retries run on the kitchen board's polling.
MAINTENANCE_SECRET=

# ── Online card payments ─────────────────────────────────────
# Full guide: docs/online-card-payments.md. OFF unless all of this is valid.
# The emergency switch: CARD_PAYMENTS_ENABLED=false.
CARD_PAYMENTS_ENABLED=false
# "simulator" (development/staging ONLY — refused when APP_ENV=production)
# or "upc" (ОББ's virtual POS, UPC e-Commerce Connect — docs/UBB-UPC-INTEGRATION.md).
PAYMENT_PROVIDER=
# upc only: sandbox | production (only with APP_ENV=production).
PAYMENT_ENV=
# sandbox on the LIVE site (APP_ENV=production) is refused unless this is
# "staff": only signed-in staff see the card option, every order is a TEST
# order and none reaches the kitchen. Ignored elsewhere.
PAYMENT_SANDBOX_AUDIENCE=
# The terminal's currency, CONFIRMED by ОББ (not guessed). The site charges EUR only.
PAYMENT_CURRENCY=
# Simulator only: signs its callbacks. Long random string (>= 16 chars).
PAYMENT_SIMULATOR_SECRET=

# ── ОББ / UPC e-Commerce Connect (PAYMENT_PROVIDER=upc) ───────
# Test terminal from ОББ's e-mail of 29.10.2026: MerchantID 1731096, TerminalID E7059096.
UPC_MERCHANT_ID=
UPC_TERMINAL_ID=
# SECRET. OUR RSA private key (PEM, or the PEM base64-encoded on one line).
# Never commit it; on Render it is a secret environment variable.
UPC_PRIVATE_KEY=
# Optional: our public certificate (the 1731096.crt sent to ОББ) — checked
# against UPC_PRIVATE_KEY at start-up. Public, not secret.
UPC_MERCHANT_CERT=
# UPC's public certificate that verifies NOTIFY / returns. Sandbox default:
# UPC's published test certificate (lib/payments/upc/certs.ts). Production: required.
UPC_GATEWAY_CERT=
# Sandbox defaults: https://ecg.test.upc.ua/kbc/pay and https://ecg.test.upc.ua/kbc/service/01.
# Production: the addresses ОББ sends with the production MerchantID/TerminalID.
UPC_GATEWAY_URL=
UPC_STATUS_URL=
# sha512 (default) | sha256 | sha1 — the hash of OUR signature.
UPC_REQUEST_SIGNATURE_ALG=
# Hashes accepted on UPC's signature. Sandbox default "sha512" (verified on a real KBC answer); production: pin explicitly.
UPC_GATEWAY_SIGNATURE_ALGS=
# json (default): status answers signed by UPC and verified | text: unsigned fallback.
UPC_STATUS_PROTOCOL=

# ── Printing — НЕ е свързано още ─────────────────────────────
# PRINTER_MODE="browser" # browser | network | agent
