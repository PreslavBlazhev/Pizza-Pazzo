# ─────────────────────────────────────────────────────────────
# Pizza Pazzo — environment variables (EXAMPLE)
# Copy this file to `.env.local` and fill in real values there.
# NEVER commit real credentials. `.env.local` is gitignored.
# ─────────────────────────────────────────────────────────────

# App
NEXT_PUBLIC_SITE_NAME="Pizza Pazzo"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ── Supabase (auth + database) ───────────────────────────────
# Къде се намират: Supabase Dashboard → Project Settings → API
#
# Без тези ключове сайтът работи нормално, но вход/регистрация и
# админ панелът показват съобщение, че Supabase не е конфигуриран.

# Project URL, напр. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_URL=""

# anon / public key. Стига до браузъра — това е нормално и безопасно,
# защото достъпът се ограничава от Row Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ⚠️ service_role key — ЗАОБИКАЛЯ Row Level Security изцяло.
# - НИКОГА не го слагай в променлива с префикс NEXT_PUBLIC_
# - НИКОГА не го използвай в client component
# - НИКОГА не го commit-вай
# Използва се само в lib/supabase/admin.ts (създаване на служебни профили).
# Ако липсва: всичко останало работи, само създаването на staff/admin профили
# от /admin/users е недостъпно.
SUPABASE_SERVICE_ROLE_KEY=""

# ── Email (transactional) — НЕ е свързано още ────────────────
# EMAIL_PROVIDER_API_KEY=""
# EMAIL_FROM="orders@pizza-pazzo.example"

# ── Printing — НЕ е свързано още ─────────────────────────────
# PRINTER_MODE="browser" # browser | network | agent
